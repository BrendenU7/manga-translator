{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "1.0.0",
  "description": "Translate manga, manhwa and manhua images in place while you read, using your own Manga Translator app.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga Translator",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "contextMenus", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": { "id": "manga-translator@localhost", "strict_min_version": "121.0" }
  }
}
