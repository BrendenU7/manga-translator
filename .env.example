# Copy to .env and fill in. Without a key the app runs in demo mode (placeholder translations).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional
# FONT_PATH=fonts/comic.ttf     # any .ttf; a comic font looks much better
# USE_GPU=1                     # if you have CUDA
# MAX_UPLOAD_MB=25
# DETECTOR=ctd                 # ctd (manga-trained, default) or easyocr
# CLAUDE_VISION=1               # send bubble images to Claude
# UPPERCASE_TEXT=1              # ALL-CAPS lettering
# RETENTION_DAYS=10             # auto-delete uploads and results after this many days
# WORKERS=2                     # pages processed at the same time
